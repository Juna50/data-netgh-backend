# Server
PORT=5000
NODE_ENV=development

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/netgh_db

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# Admin credentials (first admin account)
ADMIN_EMAIL=admin@netgh.com
ADMIN_PASSWORD=change_this_password

# Moolre Payment Gateway (https://moolre.com)
MOOLRE_API_KEY=your_moolre_api_key
MOOLRE_BASE_URL=https://api.moolre.com/v1
MOOLRE_CALLBACK_URL=https://your-backend.onrender.com/api/payments/callback

# Frontend URL (for CORS)
FRONTEND_URL=https://netgh.vercel.app

# App Settings
APP_NAME=NetGH
APP_CURRENCY=GHS
